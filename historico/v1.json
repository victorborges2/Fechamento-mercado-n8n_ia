      "parameters": {
        "jsCode": "// Consolida todos os dados coletados num prompt para o Claude\nconst pct = (preco, ant) => ant ? (((preco - ant) / ant) * 100).toFixed(2) + '%' : 'n/d';\nconst linhas = [];\n\n// Ibovespa\ntry {\n  const ibov = $('Ibovespa (brapi)').first().json.results[0];\n  linhas.push(`Ibovespa: ${ibov.regularMarketPrice} pts (${(ibov.regularMarketChangePercent ?? 0).toFixed(2)}% no dia)`);\n} catch (e) { linhas.push('Ibovespa: indisponível'); }\n\n// Câmbio\ntry {\n  const fx = $('Câmbio (AwesomeAPI)').first().json;\n  linhas.push(`Dólar: R$ ${Number(fx.USDBRL.bid).toFixed(2)} (${fx.USDBRL.pctChange}% no dia)`);\n  linhas.push(`Euro: R$ ${Number(fx.EURBRL.bid).toFixed(2)} (${fx.EURBRL.pctChange}% no dia)`);\n} catch (e) { linhas.push('Câmbio: indisponível'); }\n\n// Macro Brasil\ntry { linhas.push(`Selic (meta): ${$('Selic (BCB)').first().json[0].valor}% a.a.`); } catch (e) {}\ntry { linhas.push(`IPCA (último mês): ${$('IPCA (BCB)').first().json[0].valor}%`); } catch (e) {}\n\n// Yahoo Finance\nconst yahoo = (nome, node) => {\n  try {\n    const m = $(node).first().json.chart.result[0].meta;\n    const ant = m.chartPreviousClose ?? m.previousClose;\n    linhas.push(`${nome}: ${m.regularMarketPrice} (${pct(m.regularMarketPrice, ant)})`);\n  } catch (e) { linhas.push(`${nome}: indisponível`); }\n};\nyahoo('S&P 500', 'S&P 500 (Yahoo)');\nyahoo('Nasdaq', 'Nasdaq (Yahoo)');\nyahoo('Petróleo WTI (US$)', 'Petróleo WTI (Yahoo)');\nyahoo('Ouro (US$/oz)', 'Ouro (Yahoo)');\n\n// Notícias\nlet noticiasBR = '', noticiasGlobal = '';\ntry { noticiasBR = $('Notícias BR (InfoMoney)').all().slice(0, 8).map(i => `- ${i.json.title}`).join('\\n'); } catch (e) {}\ntry { noticiasGlobal = $('Notícias Global (CNBC)').all().slice(0, 8).map(i => `- ${i.json.title}`).join('\\n'); } catch (e) {}\n\nconst hoje = new Date().toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo', weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });\n\nconst prompt = `Você é um analista de mercado sênior escrevendo o resumo matinal de ${hoje} para um investidor brasileiro.\n\nDADOS DE MERCADO:\n${linhas.join('\\n')}\n\nMANCHETES BRASIL (InfoMoney):\n${noticiasBR || 'indisponível'}\n\nMANCHETES GLOBAIS (CNBC):\n${noticiasGlobal || 'indisponível'}\n\nEscreva um e-mail em HTML (use apenas tags HTML simples: h2, h3, p, ul, li, strong — sem markdown, sem <html>/<body>) com esta estrutura:\n1. \"Visão geral\" — 2-3 frases conectando o cenário do dia\n2. \"Brasil\" — Ibovespa, dólar, Selic/IPCA e o que explica os movimentos\n3. \"EUA e mundo\" — índices, commodities e contexto\n4. \"3 notícias para acompanhar\" — as 3 manchetes mais relevantes com 1 linha de contexto cada\n\nTom direto e profissional, em português. Se algum dado estiver indisponível, apenas omita. Responda SOMENTE com o HTML, nada antes ou depois.`;\n\nreturn [{ json: { prompt } }];"
      },
      "name": "Consolidar dados",
